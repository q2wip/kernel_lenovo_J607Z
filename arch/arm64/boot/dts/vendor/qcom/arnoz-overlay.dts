/dts-v1/;
/plugin/;

#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/clock/qcom,gcc-lagoon.h>
#include "arnoz.dtsi"

/ {
	model = "Lenovo arnoz_prc";
	compatible = "qcom,lagoon-mtp", "qcom,lagoon", "qcom,mtp";
	qcom,msm-id = <0x1b2 0x10000 0x1cb 0x10000>;
	qcom,board-id = <8 0>;

	/*
	 * Bringup GPU overrides — explicitly set key parameters for A619
	 * to minimize reliance on driver defaults. The bootloader selects
	 * lagoon.dtb (wildcard board-id <0 0>) as base, and this overlay
	 * is applied on top.
	 */
	fragment@1 {
		target-path = "/soc/qcom,kgsl-3d0@3d00000";
		__overlay__ {
			qcom,highest-bank-bit = <13>;
			qcom,chipid = <0x06010900>;
		};
	};

	fragment@2 {
		target-path = "/soc/arm,smmu-kgsl@3d40000";
		__overlay__ {
			qcom,no-dynamic-asid;
		};
	};

	fragment@3 {
		target-path = "/soc/qcom,gmu@3d6a000";
		__overlay__ {
			status = "ok";
		};
	};
};

// DWC3 core driver (CIP 4.19.325) requires 'ref' clock; lagoon DTS doesn't provide it.
// This causes "Failed to get clk 'ref': -2" and USB enumeration failure.
&{/soc/a600000.ssusb/dwc3@a600000} {
	clocks = <&gcc GCC_USB3_PRIM_CLKREF_CLK>;
	clock-names = "ref";
};

// Kernel built-in DTC 1.7.0 drops properties with values > 0xFFFFFF from
// the base lagoon.dtb (same bug as cdc-vdd-mic-bias-voltage truncation).
// qcom,swr-master-version = <0x01050001> (0x1050001 dec > 0xFFFFFF) is
// silently dropped, causing the SWR master to default to v1.6 (0x01060000)
// while actual HW is v1.5.1 — slave enumeration fails with "device not ready".
// Restore the property via DTBO overlay (compiled with system DTC 1.7.2).
&swr0 {
	qcom,swr-master-version = <0x01050001>;
};

&swr1 {
	qcom,swr-master-version = <0x01050001>;
};

&swr2 {
	qcom,swr-master-version = <0x01050001>;
};
