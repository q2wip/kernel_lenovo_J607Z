# J607F A16 bringup config fragment
# Options aligned with gauguin A16 (lito-perf_defconfig + gauguin.config)

# Required for building DTBO overlays from source
CONFIG_BUILD_ARM64_DT_OVERLAY=y

# Serial console for init logs (gauguin also sets this)
CONFIG_SERIAL_MSM_GENI_CONSOLE=y

# Required for virtual A/B OTA (userfaultfd GC)
CONFIG_USERFAULTFD=y

# PSI (pressure stall information) — required for A16 lmkd
CONFIG_PSI=y

# Ashmem compatibility layer (required for A16)
CONFIG_MEMFD_ASHMEM_SHIM=y

# Performance cmdline: kpti=off to reduce syscall overhead,
# rcu_nocbs+rcu_expedited for lower scheduling latency
CONFIG_CMDLINE="ignore_loglevel kpti=off rcupdate.rcu_expedited=1 rcu_nocbs=0-7 drm.debug=0x1e fbcon=rotate:2"
CONFIG_CMDLINE_EXTEND=y

# PStore — critical for bringup debugging (gauguin)
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# Ramdisk LZ4 — faster boot (gauguin)
CONFIG_RD_LZ4=y

# exFAT — SD card / OTG support (gauguin)
CONFIG_EXFAT_FS=y
CONFIG_UNICODE=y

# Netlabel (gauguin)
CONFIG_NETLABEL=y

# SECURITY — align with gauguin lito-perf_defconfig
CONFIG_SECURITY_NETWORK=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_DEFAULT_MMAP_MIN_ADDR=32768
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_SCHED_STACK_END_CHECK=y

# CRYPTO — align with gauguin lito-perf_defconfig
CONFIG_CRYPTO_CHACHA20POLY1305=y
CONFIG_CRYPTO_DRBG_HASH=y
CONFIG_CRYPTO_DRBG_CTR=y

# Cgroup — align with gauguin lito-perf_defconfig
CONFIG_CGROUP_SCHED=y

# Performance — align with gauguin lito-perf_defconfig
CONFIG_JUMP_LABEL=y

# EROFS — align with gauguin for A16 optimization
CONFIG_EROFS_FS_PCPU_KTHREAD=y
CONFIG_EROFS_FS_PCPU_KTHREAD_HIPRI=y

# RmNet (gauguin)
CONFIG_RMNET_PERF=y
CONFIG_RMNET_SHS=y

# Fastboot over UART (gauguin, useful for bringup debugging)
CONFIG_FASTBOOT_CMD_CTRL_UART=y

# CPU_BOOST/MSM_PERFORMANCE — keep enabled (arnoz_defconfig default) for performance
# IOMMU debug — minimal, keep IOMMU_DEBUG + TESTS but skip verbose sync debug
CONFIG_IOMMU_DEBUG=y
CONFIG_IOMMU_TESTS=y
# CONFIG_IOMMU_TLBSYNC_DEBUG is not set
# CONFIG_ARM_SMMU_TESTBUS_DUMP is not set

# Disable DBMDX audio DSP (dbmd4_spi_probe NULL pointer dereference — kills init)
# CONFIG_SND_SOC_DBMDX is not set

# USB gadget configfs + function drivers
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_UEVENT=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_F_MTP=y
CONFIG_USB_F_PTP=y
CONFIG_USB_F_ACC=y
CONFIG_USB_F_AUDIO_SRC=y

# Audio drivers (from techpack/audio/config/litoauto.conf — built-in =y)
CONFIG_PINCTRL_LPI=y
CONFIG_AUDIO_EXT_CLK=y
CONFIG_SND_SOC_WCD9XXX_V2=y
CONFIG_SND_SOC_WCD_MBHC=y
CONFIG_SND_SOC_WSA881X=y
CONFIG_SND_SOC_WSA883X=y
CONFIG_WCD9XXX_CODEC_CORE_V2=y
CONFIG_MSM_CDC_PINCTRL=y
CONFIG_MSM_QDSP6V2_CODECS=y
CONFIG_MSM_ULTRASOUND=y
CONFIG_MSM_QDSP6_APRV2_RPMSG=y
CONFIG_MSM_ADSP_LOADER=y
CONFIG_REGMAP_SWR=y
CONFIG_MSM_QDSP6_SSR=y
CONFIG_MSM_QDSP6_PDR=y
CONFIG_MSM_QDSP6_NOTIFIER=y
CONFIG_SND_SOC_MSM_HOSTLESS_PCM=y
CONFIG_SND_SOC_MSM_QDSP6V2_INTF=y
CONFIG_SOUNDWIRE=y
CONFIG_SOUNDWIRE_MSTR_CTRL=y
CONFIG_SND_SOC_QDSP6V2=y
CONFIG_SND_SOC_WCD_MBHC_ADC=y
CONFIG_SND_SOC_MSM_HDMI_CODEC_RX=y
CONFIG_QTI_PP=y
CONFIG_SND_HWDEP_ROUTING=y
CONFIG_SND_SOC_MSM_STUB=y
CONFIG_MSM_AVTIMER=y
CONFIG_SND_SOC_BOLERO=y
CONFIG_WSA_MACRO=y
CONFIG_VA_MACRO=y
CONFIG_RX_MACRO=y
CONFIG_TX_MACRO=y
CONFIG_DIGITAL_CDC_RSC_MGR=y
CONFIG_SND_SOC_WCD_IRQ=y
CONFIG_SND_SOC_WCD938X=y
CONFIG_SND_SOC_WCD938X_SLAVE=y
CONFIG_SND_SOC_WCD937X=y
CONFIG_SND_SOC_WCD937X_SLAVE=y
CONFIG_SND_SOC_LITO=y
CONFIG_SND_EVENT=y
CONFIG_MI2S_DISABLE=y
CONFIG_AUXPCM_DISABLE=y
CONFIG_SND_SOC_CS35L41=y
